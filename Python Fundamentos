"""
Sistema de registro de atenciones - Posta San Carlos (prototipo)
Versión de un solo archivo para Google Colab o cualquier entorno Python.
"""
import csv
import os
from datetime import datetime

ARCHIVO = "atenciones.csv"
CAMPOS = ["fecha", "hora", "dni", "nombre", "edad", "motivo"]


# ---------------- VALIDACIONES ----------------
def validar_dni(dni: str) -> bool:
    """El DNI peruano tiene 8 dígitos numéricos."""
    return dni.isdigit() and len(dni) == 8


def validar_nombre(nombre: str) -> bool:
    """Al menos 3 caracteres, solo letras y espacios."""
    limpio = nombre.strip()
    return len(limpio) >= 3 and all(c.isalpha() or c.isspace() for c in limpio)


def validar_edad(texto: str) -> bool:
    """Entero entre 0 y 120."""
    return texto.isdigit() and 0 <= int(texto) <= 120


def validar_motivo(texto: str) -> bool:
    return len(texto.strip()) >= 3


# ---------------- ALMACENAMIENTO (CSV) ----------------
def guardar_atencion(dni, nombre, edad, motivo, archivo=ARCHIVO, fecha=None, hora=None):
    """Agrega una atención al CSV. Si no se indica fecha/hora, usa las actuales."""
    existe = os.path.exists(archivo)
    ahora = datetime.now()
    with open(archivo, "a", newline="", encoding="utf-8") as f:
        escritor = csv.DictWriter(f, fieldnames=CAMPOS)
        if not existe:
            escritor.writeheader()
        escritor.writerow({
            "fecha": fecha or ahora.strftime("%Y-%m-%d"),
            "hora": hora or ahora.strftime("%H:%M"),
            "dni": dni,
            "nombre": nombre.strip().title(),
            "edad": int(edad),
            "motivo": motivo.strip().lower(),
        })


def cargar_atenciones(archivo=ARCHIVO):
    """Devuelve la lista de atenciones (lista de diccionarios)."""
    if not os.path.exists(archivo):
        return []
    with open(archivo, newline="", encoding="utf-8") as f:
        return list(csv.DictReader(f))


def buscar_por_dni(dni, archivo=ARCHIVO):
    return [a for a in cargar_atenciones(archivo) if a["dni"] == dni]


# ---------------- REPORTES ----------------
def contar_por_campo(campo, archivo=ARCHIVO):
    """Cuenta atenciones agrupadas por un campo (fecha, motivo, ...)."""
    conteo = {}
    for atencion in cargar_atenciones(archivo):
        clave = atencion[campo]
        conteo[clave] = conteo.get(clave, 0) + 1
    return conteo


def imprimir_reporte(titulo, conteo):
    print(f"\n=== {titulo} ===")
    if not conteo:
        print("Sin datos registrados.")
        return
    for clave, cantidad in sorted(conteo.items(), key=lambda x: -x[1]):
        print(f"{clave:<25} {cantidad}")
    print(f"{'TOTAL':<25} {sum(conteo.values())}")


# ---------------- INTERFAZ DE CONSOLA ----------------
def pedir_dato(mensaje, validador, error):
    """Repite la pregunta hasta que el dato sea válido."""
    while True:
        valor = input(mensaje).strip()
        if validador(valor):
            return valor
        print(f"  ! {error}")


def registrar():
    dni = pedir_dato("DNI (8 dígitos): ", validar_dni, "DNI inválido.")
    nombre = pedir_dato("Nombre completo: ", validar_nombre, "Nombre inválido.")
    edad = pedir_dato("Edad: ", validar_edad, "Edad inválida (0-120).")
    motivo = pedir_dato("Motivo de atención: ", validar_motivo, "Escribe un motivo.")
    guardar_atencion(dni, nombre, edad, motivo)
    print("  Atención registrada correctamente.")


def buscar():
    dni = pedir_dato("DNI a buscar: ", validar_dni, "DNI inválido.")
    resultados = buscar_por_dni(dni)
    if not resultados:
        print("  No se encontraron atenciones.")
    for a in resultados:
        print(f"  {a['fecha']} {a['hora']} | {a['nombre']} | {a['edad']} años | {a['motivo']}")


def cargar_datos_ejemplo():
    """Carga atenciones FICTICIAS para probar los reportes."""
    ejemplos = [
        ("11111111", "Persona Uno", 34, "control prenatal"),
        ("22222222", "Persona Dos", 8, "vacunación"),
        ("33333333", "Persona Tres", 52, "consulta general"),
        ("44444444", "Persona Cuatro", 5, "vacunación"),
        ("55555555", "Persona Cinco", 27, "consulta general"),
    ]
    for dni, nombre, edad, motivo in ejemplos:
        guardar_atencion(dni, nombre, edad, motivo)
    print("  Se cargaron 5 atenciones ficticias de ejemplo.")


def menu():
    opciones = {
        "1": ("Registrar atención", registrar),
        "2": ("Buscar por DNI", buscar),
        "3": ("Reporte por día",
              lambda: imprimir_reporte("Atenciones por día", contar_por_campo("fecha"))),
        "4": ("Reporte por motivo",
              lambda: imprimir_reporte("Atenciones por motivo", contar_por_campo("motivo"))),
        "5": ("Cargar datos de ejemplo (ficticios)", cargar_datos_ejemplo),
        "0": ("Salir", None),
    }
    while True:
        print("\n--- POSTA SAN CARLOS ---")
        for clave, (texto, _) in opciones.items():
            print(f"{clave}. {texto}")
        eleccion = input("Elige una opción: ").strip()
        if eleccion == "0":
            print("Hasta luego.")
            break
        if eleccion in opciones:
            opciones[eleccion][1]()
        else:
            print("  Opción no válida.")


if __name__ == "__main__":
    menu()
